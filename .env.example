# Firebase — lấy từ Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# VAPID key cho Web Push (Firebase Cloud Messaging > Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Gemini API key (Google AI Studio) — dùng cho trợ lý AI trò chuyện tự do.
# Để trống thì app tự dùng lại kiểu trả lời theo luật (rule-based) như cũ.
VITE_GEMINI_API_KEY=
