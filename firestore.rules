rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chỉ user đã auth mới truy cập được node của chính họ
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validEvent();
        allow update: if isOwner(userId) && validEvent();
        allow delete: if isOwner(userId);
      }

      match /calendars/{calendarId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validCalendar();
        allow update: if isOwner(userId) && validCalendar();
        allow delete: if isOwner(userId);
      }
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEvent() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'startDate', 'endDate', 'isAllDay', 'color', 'calendarId'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.isAllDay is bool
        && data.color is string
        && data.calendarId is string;
    }

    function validCalendar() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'color', 'isVisible', 'isDefault'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.color is string
        && data.isVisible is bool
        && data.isDefault is bool;
    }
  }
}
